# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this during development for instant command updates in one server.
# Leave blank to register commands globally (takes up to ~1hr to propagate).
DISCORD_GUILD_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model used for every command. Change here to upgrade/downgrade.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Patch MCP ---
# Preferred: a dedicated bot login (create this as its own Patch user, not
# your personal login). The bot signs in as this user against Supabase's
# standard password grant — the same one Patch's own login page uses — and
# auto-refreshes before the token expires (see src/patch-auth.js).
PATCH_MCP_URL=https://claimyourpatch.com/mcp
PATCH_BOT_EMAIL=
PATCH_BOT_PASSWORD=
# The Supabase project Patch runs on, and its public anon/publishable key
# (safe to be public — find it in the Patch web app's own network requests
# or JS bundle; look for a header named "apikey", NOT "Authorization").
PATCH_SUPABASE_URL=https://krvxxdjohlegkddpseyk.supabase.co
PATCH_SUPABASE_ANON_KEY=
# Fallback only: a manually-issued static bearer token, used only if
# PATCH_BOT_EMAIL/PATCH_BOT_PASSWORD are blank.
PATCH_MCP_TOKEN=

# --- Madgicx MCP ---
MADGICX_MCP_URL=https://mcp.madgicx.com/mcp
# Preferred: client-credentials pair from Madgicx dashboard -> Workspace
# Settings -> MCP Integration. The bot exchanges these for a short-lived
# access token automatically (see src/madgicx-auth.js) and refreshes it
# before it expires.
MADGICX_CLIENT_ID=
MADGICX_CLIENT_SECRET=
# Fallback only: a manually-issued static bearer token. Only used if either
# of the two client-credentials vars above is blank. You are responsible for
# refreshing this yourself if you rely on it instead.
MADGICX_MCP_TOKEN=

# --- Optional scheduled digest ---
# Channel ID to post a daily pipeline + ad performance summary into.
# Leave blank to disable the scheduled digest entirely.
DIGEST_CHANNEL_ID=
# Cron expression, server's local time. Default: 8:30am on weekdays.
DIGEST_CRON=30 8 * * 1-5
