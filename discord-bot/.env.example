# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this during development for instant command updates in one server.
# Leave blank to register commands globally (takes up to ~1hr to propagate).
DISCORD_GUILD_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model used for every command. Change here to upgrade/downgrade.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Patch MCP ---
PATCH_MCP_URL=https://claimyourpatch.com/mcp
PATCH_MCP_TOKEN=

# --- Madgicx MCP ---
MADGICX_MCP_URL=https://mcp.madgicx.com/mcp
MADGICX_MCP_TOKEN=

# --- Optional scheduled digest ---
# Channel ID to post a daily pipeline + ad performance summary into.
# Leave blank to disable the scheduled digest entirely.
DIGEST_CHANNEL_ID=
# Cron expression, server's local time. Default: 8:30am on weekdays.
DIGEST_CRON=30 8 * * 1-5
